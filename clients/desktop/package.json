{
  "name": "@blockparty/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "BlockParty desktop client \u2014 Electron shell + Nuxt 3 SPA renderer (epic #26).",
  "license": "CC0-1.0",
  "homepage": "https://github.com/bpprotocol/blockparty",
  "repository": {
    "type": "git",
    "url": "https://github.com/bpprotocol/blockparty.git",
    "directory": "clients/desktop"
  },
  "author": "BlockParty",
  "main": "dist-electron/main.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm build:main && concurrently -k -n nuxt,electron \"nuxt dev\" \"wait-on http://localhost:3000 && cross-env NODE_ENV=development ELECTRON_RENDERER_URL=http://localhost:3000 electron . --no-sandbox\"",
    "build:renderer": "nuxt generate",
    "build:node": "node scripts/build-node.mjs",
    "build:main": "tsc -p electron/tsconfig.json && pnpm bundle:preload",
    "bundle:preload": "esbuild electron/preload.ts --bundle --platform=node --format=cjs --target=node20 --external:electron --outfile=dist-electron/preload.js",
    "build": "pnpm build:renderer && pnpm build:main && electron-builder",
    "build:client-only": "pnpm build:renderer && pnpm build:main && electron-builder --config electron-builder.client-only.yml",
    "pack:dir": "pnpm build:renderer && pnpm build:main && electron-builder --dir",
    "pack:dir:client-only": "pnpm build:renderer && pnpm build:main && electron-builder --dir --config electron-builder.client-only.yml",
    "typecheck": "nuxt prepare && vue-tsc --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "test": "vitest run",
    "gen:proto": "protoc --plugin=protoc-gen-es=./node_modules/.bin/protoc-gen-es --es_out=electron/gen --es_opt=target=ts,import_extension=none --proto_path=../../node/proto/v1 node.proto",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "^2.12.1",
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.3",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^9.0.0",
    "nuxt": "^3.14.0",
    "prettier": "^3.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.9",
    "vue": "^3.5.0",
    "vue-tsc": "^2.1.0",
    "wait-on": "^8.0.0"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.12.1",
    "@connectrpc/connect": "^2.1.2",
    "@connectrpc/connect-node": "^2.1.2"
  }
}
