# AppArmor profile for running the BlockParty *AppImage* on Ubuntu 23.10+.
#
# The AppImage mounts itself under /tmp/.mount_BlockP<random>/, and its
# chrome-sandbox can never be setuid root (AppImage mounts are nosuid), so the
# namespace sandbox is the only one available — and that needs this profile.
# The .deb ships an equivalent profile automatically; this file is for people
# who prefer the AppImage.
#
#   sudo install -m644 packaging/apparmor/blockparty-appimage /etc/apparmor.d/
#   sudo apparmor_parser -r /etc/apparmor.d/blockparty-appimage
abi <abi/4.0>,
include <tunables/global>

profile blockparty-appimage /tmp/.mount_BlockP*/blockparty flags=(unconfined) {
  userns,

  include if exists <local/blockparty-appimage>
}
