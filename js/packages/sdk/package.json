{
  "name": "@blockparty/sdk",
  "version": "0.1.0",
  "description": "Reusable library for the BlockParty Protocol — crypto, derivations, identity, blocks, encryption, audiences, connections, and block types.",
  "license": "CC0-1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src",
    "gen:proto": "protoc --plugin=protoc-gen-es=./node_modules/.bin/protoc-gen-es --es_out=src/blockpb --es_opt=target=ts,import_extension=js --proto_path=../../../protocol/proto/v1 block.proto block_types.proto"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.12.1",
    "@noble/ciphers": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@noble/post-quantum": "^0.6.1"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "^2.12.1"
  }
}
