{
  "name": "@blockparty/sdk",
  "version": "0.1.0",
  "description": "Reusable library for the BlockParty Protocol — crypto, derivations, identity, blocks, encryption, audiences, connections, and block types.",
  "license": "CC0-1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src"
  }
}
